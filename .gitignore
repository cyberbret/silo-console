# Playwright Data
web-app/storage/
web-app/playwright/.auth/admin.json
web-app/test-results/

# Report from Playwright
web-app/playwright-report/

# Coverage from Playwright
web-app/.nyc_output/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
.DS_Store
*.swp
*.orig

# Test binary, build with `go test -c`
*.test

.idea/
vendor/

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Ignore executables
target/
!pkg/logger/target/
console
!console/

dist/

# Ignore node_modules

/node_modules/
web-app/node_modules/

# Retired generated frontend assets
/portal-ui/build/
/portal-ui/bindata_assetfs.go
/bindata_assetfs.go

# Optimized release assets are required by Go embedders; omit debug source maps
/web-app/build/**/*.map
/web-app/build/**/*.map.gz

# Ignore tls cert and key
private.key
public.crt

# Ignore VsCode files
.vscode/
*.code-workspace
*~
.eslintcache

# Ignore Bin files
bin/
